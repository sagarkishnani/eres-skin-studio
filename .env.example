# TinaCMS: leave empty to run in local mode (edits files in src/content).
TINA_CLIENT_ID=
TINA_TOKEN=

# Baked in at build time (not read at runtime); must match the branch TinaCloud indexed.
TINA_BRANCH=staging

# Cloudflare Turnstile public site key. Local test key: 1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=

# Subpath deploys only (e.g. /subpath). Empty = site at the root.
DEPLOY_BASE=

# WooCommerce, solo en build (sin PUBLIC_ para que nunca lleguen al navegador).
# Claves de SOLO LECTURA: WooCommerce → Ajustes → Avanzado → API REST. Vacías = tienda vacía.
WOO_STORE_URL=https://eresskinstudio.com
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=
