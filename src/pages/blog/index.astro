---
import BaseLayout from "../../layouts/BaseLayout.astro";
import client from "../../../tina/__generated__/client";
import { getLocale, tField } from "../../utils/i18n";
import { isLocale } from "../../i18n/config";
import { mediaUrl } from "../../utils/mediaUrl";

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : getLocale(Astro.url);
const base = import.meta.env.BASE_URL || "/";
const prefix = locale === "es" ? base : `${base}${locale}/`;

const result = await client.queries.postConnection();
const posts = (result.data?.postConnection?.edges || [])
  .map((edge: any) => edge?.node)
  .filter(Boolean)
  .sort((a: any, b: any) => new Date(b.date || 0).getTime() - new Date(a.date || 0).getTime());
---

<BaseLayout title="Blog — ERES Skin Studio" description="Artículos y novedades.">
  <section class="section pt-[128px]">
    <div class="container-xl">
      <h1 class="text-heading-xl">Blog</h1>

      <div class="mt-12 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {posts.map((post: any) => (
          <a
            href={`${prefix}blog/${post._sys.filename}`}
            class="card group flex flex-col overflow-hidden !p-0"
          >
            {post.coverImage && (
              <img
                src={mediaUrl(post.coverImage)}
                alt=""
                class="aspect-[16/10] w-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
              />
            )}
            <div class="flex flex-1 flex-col p-6">
              <div class="flex flex-wrap gap-2">
                {(post.tags || []).map((tag: string) => (
                  <span class="rounded-full bg-accent/15 px-3 py-1 text-caption-sm text-accent">
                    {tag}
                  </span>
                ))}
              </div>
              <h2 class="mt-4 text-subtitle-sm">{tField(post, "title", locale)}</h2>
              <p class="mt-2 flex-1 text-body-sm text-content-muted">
                {tField(post, "excerpt", locale)}
              </p>
              {post.date && (
                <time class="mt-4 text-caption-sm text-content-subtle" datetime={post.date}>
                  {new Date(post.date).toLocaleDateString(locale, {
                    year: "numeric", month: "long", day: "numeric",
                  })}
                </time>
              )}
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</BaseLayout>
