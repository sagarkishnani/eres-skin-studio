# TinaCMS: leave empty to run in local mode (edits files in src/content).
TINA_CLIENT_ID=
TINA_TOKEN=

# Baked in at build time (not read at runtime); must match the branch TinaCloud indexed.
TINA_BRANCH=staging

# Cloudflare Turnstile public site key. Local test key: 1x00000000000000000000AA
PUBLIC_TURNSTILE_SITE_KEY=

# "staging" = sitio de prueba: noindex en todas las páginas y robots.txt con Disallow: /. Vacía = producción.
SITE_ENV=

# Subpath deploys only (e.g. /subpath). Empty = site at the root.
DEPLOY_BASE=

# WooCommerce, solo en build (sin PUBLIC_ para que nunca lleguen al navegador).
# Claves de SOLO LECTURA: WooCommerce → Ajustes → Avanzado → API REST. Vacías = tienda vacía.
WOO_STORE_URL=https://eresskinstudio.com
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# Público: URL completa de woo-api.php cuando el sitio se sirve desde un hosting sin PHP (Amplify).
# Vacía = /woo-api.php del mismo sitio. El origen del sitio debe estar en allowed_origins de woo-config.php.
PUBLIC_WOO_API_URL=

# Público: solo una URL. Vacía = el carrito no muestra "Finalizar compra".
# WordPress comparte dominio con el sitio: en producción es https://eresskinstudio.com/checkout/
PUBLIC_WOO_CHECKOUT_URL=https://eresskinstudio.com/checkout/
