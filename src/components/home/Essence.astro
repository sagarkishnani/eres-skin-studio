---
import EssenceReact from "./EssenceReact";

interface Props {
  query: string;
  variables: object;
  data: any;
}

const { query, variables, data } = Astro.props;
const visible = data?.home?.essence && data.home.essence.enabled !== false;
---

{visible && <EssenceReact query={query} variables={variables} data={data} client:tina />}
