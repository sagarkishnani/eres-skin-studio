---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ShopBanner from "../../components/shop/ShopBanner.astro";
import ShopBenefits from "../../components/shop/ShopBenefits.astro";
import ProductCard from "../../components/shop/ProductCard.astro";
import StockRefresher from "../../components/shop/StockRefresher.astro";
import client from "../../../tina/__generated__/client";
import { getAllProducts, getAllCategories, wooConfigured } from "../../lib/woo/rest";
import { getLocale, localizeHref } from "../../utils/i18n";
import { isLocale } from "../../i18n/config";

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : getLocale(Astro.url);

const result = await client.queries.shop({ relativePath: "index.json" });
const { query, variables, data } = result;
const seo = data?.shop?.seo;
const lowStock = data?.shop?.lowStockThreshold ?? 5;

const [products, categories] = await Promise.all([getAllProducts(), getAllCategories()]);
---

<BaseLayout title={seo?.title} description={seo?.description}>
  <ShopBanner query={query} variables={variables} data={data} />

  <section class="section">
    <div class="container-xl">
      {categories.length > 0 && (
        <nav class="mb-10 flex flex-wrap gap-2" aria-label="Categorías">
          <span class="rounded-full bg-accent px-4 py-2 text-sm font-medium text-white">
            Todos
          </span>
          {categories.map((cat) => (
            <a
              href={localizeHref(`/productos/categoria/${cat.slug}`, locale, false)}
              class="rounded-full border border-line px-4 py-2 text-sm transition-colors hover:border-line-strong"
            >
              {cat.name} <span class="text-content-subtle">({cat.count})</span>
            </a>
          ))}
        </nav>
      )}

      {products.length > 0 ? (
        <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
          {products.map((product) => (
            <ProductCard product={product} locale={locale} lowStockThreshold={lowStock} />
          ))}
        </div>
      ) : (
        <div class="border border-dashed border-line px-6 py-20 text-center">
          <p class="text-body-lg text-content-muted">
            {wooConfigured
              ? "Todavía no hay productos publicados."
              : "La tienda aún no está conectada a WooCommerce."}
          </p>
          {!wooConfigured && (
            <p class="mt-2 text-sm text-content-subtle">
              Completa WOO_STORE_URL, WOO_CONSUMER_KEY y WOO_CONSUMER_SECRET en .env
              y vuelve a compilar.
            </p>
          )}
        </div>
      )}
    </div>
  </section>

  <ShopBenefits query={query} variables={variables} data={data} />

  <StockRefresher lowStockThreshold={lowStock} />
</BaseLayout>
