---
import BaseLayout from "../../layouts/BaseLayout.astro";
import StockRefresher from "../../components/shop/StockRefresher.astro";
import AddToCartReact from "../../components/shop/AddToCartReact";
import client from "../../../tina/__generated__/client";
import { getAllProducts } from "../../lib/woo/rest";
import { formatPrice, discountPercent, stockLabel, stripHtml, isBuyable } from "../../lib/woo/format";
import { getLocale, localizeHref } from "../../utils/i18n";
import { isLocale } from "../../i18n/config";
import type { WooProduct } from "../../lib/woo/types";

export async function getStaticPaths() {
  const products = await getAllProducts();
  return products.map((product) => ({
    params: { slug: product.slug },
    props: { product },
  }));
}

interface Props { product: WooProduct }
const { product } = Astro.props;

const locale = isLocale(Astro.currentLocale) ? Astro.currentLocale : getLocale(Astro.url);
const shop = await client.queries.shop({ relativePath: "index.json" });
const lowStock = shop.data?.shop?.lowStockThreshold ?? 5;

const discount = discountPercent(product);
const stock = stockLabel(product, lowStock);
const buyable = isBuyable(product);
const gallery = product.images;

const TONE = { ok: "text-emerald-400", low: "text-amber-400", out: "text-content-subtle" };
---

<BaseLayout
  title={`${product.name} — ERES Skin Studio`}
  description={stripHtml(product.short_description || product.description, 155)}
>
  <section class="section pt-[128px]" data-woo-id={product.id}>
    <div class="container-xl">
      <nav class="mb-8 text-sm text-content-subtle" aria-label="Miga de pan">
        <a href={localizeHref("/tienda", locale, false)} class="hover:text-content">Tienda</a>
        {product.categories[0] && (
          <>
            <span class="mx-2">/</span>
            <a
              href={localizeHref(`/tienda/categoria/${product.categories[0].slug}`, locale, false)}
              class="hover:text-content"
            >
              {product.categories[0].name}
            </a>
          </>
        )}
      </nav>

      <div class="grid gap-10 lg:grid-cols-2">
        <div class="flex flex-col gap-4">
          {gallery[0] ? (
            <img
              src={gallery[0].src}
              alt={gallery[0].alt || product.name}
              width="900"
              height="900"
              class="aspect-square w-full rounded-2xl object-cover"
            />
          ) : (
            <div class="flex aspect-square w-full items-center justify-center rounded-2xl bg-surface-raised text-content-subtle">
              Sin imagen
            </div>
          )}

          {gallery.length > 1 && (
            <div class="grid grid-cols-4 gap-3">
              {gallery.slice(1, 5).map((img) => (
                <img
                  src={img.src}
                  alt={img.alt || ""}
                  width="200"
                  height="200"
                  loading="lazy"
                  class="aspect-square w-full rounded-lg object-cover"
                />
              ))}
            </div>
          )}
        </div>

        <div>
          {product.sku && <p class="text-sm text-content-subtle">SKU {product.sku}</p>}
          <h1 class="mt-1 text-heading-xl">{product.name}</h1>

          <div class="mt-5 flex items-baseline gap-3" data-woo-price>
            <span class="text-heading-md font-semibold">{formatPrice(product.price)}</span>
            {discount !== null && (
              <>
                <span class="text-body-lg text-content-subtle line-through">
                  {formatPrice(product.regular_price)}
                </span>
                <span class="rounded-full bg-accent px-2.5 py-1 text-xs font-semibold text-white">
                  -{discount}%
                </span>
              </>
            )}
          </div>

          <p class={`mt-2 text-sm ${TONE[stock.tone]}`} data-woo-stock>{stock.text}</p>

          {product.short_description && (
            <div
              class="prose mt-6 max-w-none text-content-muted"
              set:html={product.short_description}
            />
          )}

          <div class="mt-8">
            <AddToCartReact productId={product.id} disabled={!buyable} client:visible />
          </div>

          {product.attributes.length > 0 && (
            <dl class="mt-10 divide-y divide-line border-t border-line">
              {product.attributes.map((attr) => (
                <div class="flex gap-4 py-3 text-sm">
                  <dt class="w-40 shrink-0 text-content-subtle">{attr.name}</dt>
                  <dd>{attr.options.join(", ")}</dd>
                </div>
              ))}
            </dl>
          )}
        </div>
      </div>

      {product.description && (
        <div class="mt-16 max-w-3xl">
          <h2 class="text-heading-sm">Descripción</h2>
          <div class="prose mt-4 max-w-none text-content-muted" set:html={product.description} />
        </div>
      )}
    </div>
  </section>

  <StockRefresher lowStockThreshold={lowStock} />
</BaseLayout>
