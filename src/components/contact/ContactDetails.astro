---
import ContactDetailsReact from "./ContactDetailsReact";
import type { StudioContact } from "./ContactDetailsReact";

interface Props {
  query: string;
  variables: object;
  data: any;
  studioContact: StudioContact;
}

const { query, variables, data, studioContact } = Astro.props;
const visible = data?.contact?.details && data.contact.details.enabled !== false;
---

{visible && <ContactDetailsReact query={query} variables={variables} data={data} studioContact={studioContact} client:tina />}

<script>
  import { startOpeningHours } from "../../scripts/openingHours";
  import { startCopyAddress } from "../../scripts/copyAddress";

  function startContactDetails() {
    startOpeningHours();
    startCopyAddress();
  }

  startContactDetails();
  document.addEventListener("astro:after-swap", startContactDetails);
</script>
