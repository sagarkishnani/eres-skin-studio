{
  "formId": "libro-de-reclamaciones",
  "styleVariant": "contact",
  "submitButtonText": "Ingresar reclamo",
  "successTitle": "Reclamo registrado",
  "successMessage": "Te enviamos la constancia a tu correo. Guarda tu número de reclamo.",
  "errorMessage": "Ocurrió un error al enviar. Inténtalo de nuevo.",
  "validationMessage": "Por favor completa los campos obligatorios.",
  "showCorrelativo": true,
  "fields": [
    {
      "fieldType": "section_header",
      "label": "1. Identificación del consumidor",
      "width": "full",
      "sectionNumber": 1,
      "order": 1
    },
    {
      "fieldType": "text",
      "name": "nombreCompleto",
      "label": "Nombre completo",
      "required": true,
      "width": "full",
      "order": 2
    },
    {
      "fieldType": "text",
      "name": "direccion",
      "label": "Dirección",
      "required": true,
      "width": "full",
      "order": 3
    },
    {
      "fieldType": "select",
      "name": "tipoDocumento",
      "label": "Tipo de documento",
      "placeholder": "Selecciona",
      "required": true,
      "width": "half",
      "options": [
        {
          "value": "DNI",
          "label": "DNI"
        },
        {
          "value": "Carné de Extranjería",
          "label": "Carné de Extranjería"
        },
        {
          "value": "Pasaporte",
          "label": "Pasaporte"
        },
        {
          "value": "RUC",
          "label": "RUC"
        }
      ],
      "order": 4
    },
    {
      "fieldType": "text",
      "name": "numeroDocumento",
      "label": "Número de documento",
      "required": true,
      "width": "half",
      "validation": {
        "pattern": "^[A-Za-z0-9]{5,12}$",
        "patternMessage": "Ingresa un número de documento válido"
      },
      "order": 5
    },
    {
      "fieldType": "email",
      "name": "correo",
      "label": "Correo electrónico",
      "placeholder": "nombre@correo.com",
      "required": true,
      "width": "half",
      "order": 6
    },
    {
      "fieldType": "text",
      "name": "telefono",
      "label": "Teléfono",
      "placeholder": "999 999 999",
      "required": true,
      "width": "half",
      "validation": {
        "pattern": "^[0-9+() -]{6,20}$",
        "patternMessage": "Ingresa un teléfono válido"
      },
      "order": 7
    },
    {
      "fieldType": "section_header",
      "label": "2. Identificación del bien contratado",
      "width": "full",
      "sectionNumber": 2,
      "order": 8
    },
    {
      "fieldType": "select",
      "name": "tipoBien",
      "label": "Tipo de bien",
      "placeholder": "Selecciona",
      "required": true,
      "width": "half",
      "options": [
        {
          "value": "Producto",
          "label": "Producto"
        },
        {
          "value": "Servicio",
          "label": "Servicio"
        }
      ],
      "order": 9
    },
    {
      "fieldType": "currency",
      "name": "montoReclamado",
      "label": "Monto reclamado",
      "required": false,
      "width": "half",
      "order": 10
    },
    {
      "fieldType": "textarea",
      "name": "descripcionBien",
      "label": "Descripción del bien contratado",
      "required": true,
      "width": "full",
      "order": 11
    },
    {
      "fieldType": "section_header",
      "label": "3. Detalle de reclamación o pedido",
      "width": "full",
      "sectionNumber": 3,
      "order": 12
    },
    {
      "fieldType": "select",
      "name": "tipoSolicitud",
      "label": "Tipo de solicitud",
      "placeholder": "Selecciona",
      "required": true,
      "width": "full",
      "options": [
        {
          "value": "Reclamo",
          "label": "Reclamo"
        },
        {
          "value": "Queja",
          "label": "Queja"
        }
      ],
      "order": 13
    },
    {
      "fieldType": "textarea",
      "name": "detalle",
      "label": "Detalle",
      "required": true,
      "width": "full",
      "order": 14
    },
    {
      "fieldType": "textarea",
      "name": "pedido",
      "label": "Pedido",
      "required": true,
      "width": "full",
      "order": 15
    },
    {
      "fieldType": "section_header",
      "label": "4. Observaciones y acciones adoptadas por el proveedor",
      "width": "full",
      "sectionNumber": 4,
      "order": 16
    },
    {
      "fieldType": "note",
      "width": "full",
      "noteContent": "* La respuesta de este reclamo o queja se enviará a través del mail indicado.",
      "order": 17
    },
    {
      "fieldType": "note",
      "width": "full",
      "noteContent": "* La formulación del reclamo no impide acudir a otras vías de solución de controversias ni es requisito previo para interponer una denuncia ante el INDECOPI.",
      "order": 18
    },
    {
      "fieldType": "note",
      "width": "full",
      "noteContent": "* El proveedor deberá dar respuesta al reclamo en un plazo no mayor a treinta (30) días calendario, pudiendo ampliar el plazo hasta por treinta (30) días más, previa comunicación con el consumidor.",
      "order": 19
    }
  ]
}
