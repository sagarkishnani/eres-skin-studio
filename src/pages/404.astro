---
import BaseLayout from "../layouts/BaseLayout.astro";
import NotFound from "../components/system-pages/NotFound.astro";
import client from "../../tina/__generated__/client";

const result = await client.queries.systemPages({ relativePath: "index.json" });
const notFound = result.data?.systemPages?.notFound;
---

<BaseLayout
  title={notFound?.seo?.title || "Página no encontrada — ERES Skin Studio"}
  description={notFound?.seo?.description || notFound?.intro || undefined}
>
  <NotFound query={result.query} variables={result.variables} data={result.data} />
</BaseLayout>
