---
import ContactDetailsReact from "./ContactDetailsReact";
import type { Contact } from "../shared/contactLinks";

interface Props {
  query: string;
  variables: object;
  data: any;
  studioContact: Contact;
}

const { query, variables, data, studioContact } = Astro.props;
const visible = data?.contact?.details && data.contact.details.enabled !== false;
---

{visible && <ContactDetailsReact query={query} variables={variables} data={data} studioContact={studioContact} client:tina />}
