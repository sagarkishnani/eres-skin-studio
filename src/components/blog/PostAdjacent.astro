---
import { PiCaretLeft, PiCaretRight } from "react-icons/pi";
import { journalPostHref, type AdjacentPosts } from "../../utils/journal";
import { groupHoverUnderline } from "./underline";

interface Props {
  adjacent: AdjacentPosts;
}

const { previous, next } = Astro.props.adjacent;

const labelClass = "flex items-center gap-2 text-body-xs text-content-muted";
const titleClass = "text-[17px] leading-[1.25] tracking-[-.015em] text-content [text-wrap:balance] md:text-[22px]";
---

<nav aria-label="Más artículos" class="mt-7 grid grid-cols-2 gap-6 border-t border-line pt-8">
  <a href={journalPostHref(previous)} rel="prev" class="group flex min-w-0 flex-col gap-2.5">
    <span class={labelClass}><PiCaretLeft size={14} aria-hidden="true" />Anterior</span>
    <span class={titleClass}><span class={`${groupHoverUnderline} duration-500`}>{previous.title}</span></span>
  </a>
  <a href={journalPostHref(next)} rel="next" class="group flex min-w-0 flex-col items-end gap-2.5 text-right">
    <span class={labelClass}>Siguiente<PiCaretRight size={14} aria-hidden="true" /></span>
    <span class={titleClass}><span class={`${groupHoverUnderline} duration-500`}>{next.title}</span></span>
  </a>
</nav>
