---
import BaseLayout from "../layouts/BaseLayout.astro";
import LegalPage from "../components/legal/LegalPage.astro";
import client from "../../tina/__generated__/client";

export async function getStaticPaths() {
  const connection = await client.queries.legalConnection({ first: 100 });
  const edges = connection.data?.legalConnection?.edges || [];
  return edges.flatMap((edge) => (edge?.node ? [{ params: { legal: edge.node._sys.filename } }] : []));
}

const { legal } = Astro.params;
const { query, variables, data } = await client.queries.legal({ relativePath: `${legal}.mdx` });
const page = data?.legal;
---

<BaseLayout
  title={page?.seo?.title || `${page?.title} — ERES Skin Studio`}
  description={page?.seo?.description || page?.intro || undefined}
>
  <LegalPage query={query} variables={variables} data={data} />
</BaseLayout>
