---
import FeaturesReact from "./FeaturesReact";
import type { Locale } from "../../i18n/config";

interface Props {
  query: string;
  variables: object;
  data: any;
  locale: Locale;
}

const { query, variables, data, locale } = Astro.props;
---

<FeaturesReact query={query} variables={variables} data={data} locale={locale} client:visible />
